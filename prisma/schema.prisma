generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  OWNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  CLOSED
  DELETED
}

enum InvestmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  DELETED
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String             @db.VarChar(120)
  email               String             @unique @db.VarChar(255)
  passwordHash        String
  role                Role               @default(USER)
  status              UserStatus         @default(ACTIVE)
  projects            Project[]          @relation("ProjectOwner")
  investmentRequests  InvestmentRequest[] @relation("RequestInvestor")
  reviewedRequests    InvestmentRequest[] @relation("RequestReviewer")
  notifications       Notification[]
  chatbotHistory      ChatbotHistory[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(500)
  status      CategoryStatus @default(ACTIVE)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
  @@index([status])
}

model Project {
  id                 String             @id @default(uuid()) @db.Uuid
  ownerId            String             @db.Uuid
  categoryId         String             @db.Uuid
  title              String             @db.VarChar(160)
  slug               String             @unique @db.VarChar(190)
  description        String             @db.Text
  targetAmount       Decimal            @db.Decimal(14, 2)
  raisedAmount       Decimal            @default(0) @db.Decimal(14, 2)
  status             ProjectStatus      @default(DRAFT)
  imageUrl           String?
  owner              User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category           Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  investmentRequests InvestmentRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([ownerId])
  @@index([categoryId])
  @@index([status, createdAt])
  @@map("projects")
}

model InvestmentRequest {
  id         String                   @id @default(uuid()) @db.Uuid
  projectId  String                   @db.Uuid
  investorId String                   @db.Uuid
  reviewerId String?                  @db.Uuid
  amount     Decimal                  @db.Decimal(14, 2)
  message    String?                  @db.VarChar(2000)
  status     InvestmentRequestStatus  @default(PENDING)
  project    Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  investor   User                     @relation("RequestInvestor", fields: [investorId], references: [id], onDelete: Cascade)
  reviewer   User?                    @relation("RequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@unique([projectId, investorId])
  @@index([investorId, createdAt])
  @@index([projectId, status])
  @@map("investment_requests")
}

model Notification {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  title             String  @db.VarChar(160)
  message           String  @db.VarChar(1000)
  type              String  @default("info") @db.VarChar(40)
  routeDestination String? @db.VarChar(500)
  metadata          Json?
  readAt            DateTime?
  deletedAt         DateTime?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([userId, deletedAt, createdAt])
  @@map("notifications")
}

model ChatbotHistory {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  userMessage String   @db.Text
  botResponse String   @db.Text
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("chatbot_histories")
}
